    {
      "parameters": {
        "jsCode": "const manana = $now.plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst encargos = $input.all()\n  .map(i => i.json)\n  .filter(e => e.fecha_entrega === manana && (e.estado === 'pendiente' || e.estado === 'pagado'));\n\nconst salida = [];\n\nfor (const e of encargos) {\n  if (e.estado === 'pagado') {\n    salida.push({\n      json: {\n        tipo: 'cliente',\n        destinatario: e.email,\n        asunto: `Tu encargo #${e.id}: mañana puedes recoger tu tarta`,\n        texto: `Hola ${e.cliente},\\n\\nMañana puedes recoger tu tarta (${e.tarta}, encargo #${e.id}).\\n\\nPastelería La Cuchara`\n      }\n    });\n  } else {\n    salida.push({\n      json: {\n        tipo: 'cliente',\n        destinatario: e.email,\n        asunto: `Tu encargo #${e.id}: mañana es la entrega`,\n        texto: `Hola ${e.cliente},\\n\\nMañana es la entrega de tu ${e.tarta} (encargo #${e.id}) y aún te faltan ${e.pendiente.toFixed(2)} €.\\n\\nPastelería La Cuchara`\n      }\n    });\n  }\n}\n\nif (encargos.length) {\n  const lineas = encargos.map(e => {\n    const estado = e.estado === 'pagado' ? 'pagado' : `pendiente, faltan ${e.pendiente.toFixed(2)} €`;\n    return `- ${e.cliente}: ${e.tarta} (#${e.id}) — ${estado}`;\n  });\n  salida.push({\n    json: {\n      tipo: 'marisa',\n      destinatario: 'marisa@lacuchara.example',\n      asunto: `Entregas de mañana (${encargos.length})`,\n      texto: `Hola Marisa,\\n\\nMañana hay ${encargos.length} entrega(s):\\n\\n${lineas.join('\\n')}`\n    }\n  });\n}\n\nreturn salida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
